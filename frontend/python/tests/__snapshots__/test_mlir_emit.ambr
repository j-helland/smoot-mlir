# serializer version: 1
# name: test_mlir_emitter[func_add]
  '''
  module {
    func.func @func_add(%x: !units.quantity<f64, #units.unit<"meter">>, %y: !units.quantity<f64, #units.unit<"meter">>) -> !units.quantity<f64, #units.unit<"meter">> {
      %0 = units.add %x, %y
        : !units.quantity<f64, #units.unit<"meter">>, !units.quantity<f64, #units.unit<"meter">>
      return %0: !units.quantity<f64, #units.unit<"meter">>
    }
  }
  
  '''
